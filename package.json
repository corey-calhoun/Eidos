{
  "name": "eidos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start:api": "node dist-server/server/index.js",
    "start:web": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "audit": "npm audit --omit=dev --audit-level=high",
    "accept": "npm run typecheck && npm test && npm run build && npm run audit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "cytoscape": "3.34.2",
    "cytoscape-fcose": "2.2.0",
    "fastify": "5.12.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "esbuild": "0.25.12"
  }
}
